# Copia este archivo como .env y completa los valores. NUNCA subas el .env al repositorio.

# Elige UNA de las dos opciones. El backend usa SSL solo cuando el host NO es localhost/127.0.0.1.
#
# Opción A — Postgres local con Docker (docker compose up -d en la raíz del proyecto). Sin SSL.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/booking_db
#
# Opción B — Supabase -> Connect -> "Session pooler" o "Transaction pooler" (IPv4). SSL obligatorio.
# Formato: postgresql://postgres.<ref>:<CLAVE>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# development | production  (en production: HSTS, redirección a HTTPS y no se muestra el enlace simulado de recuperación)
APP_ENV=development
NODE_ENV=development
PORT=3000

# Secreto HS256 de al menos 32 caracteres aleatorios. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30m

# Orígenes permitidos (URL exacta del frontend, separadas por comas; nunca '*')
CORS_ORIGINS=http://localhost:4200

# URL pública del frontend (enlaces de alojamientos y del correo simulado de recuperación)
PUBLIC_WEB_URL=http://localhost:4200
# URL pública del backend (enlaces HATEOAS _links de las órdenes)
API_PUBLIC_URL=http://localhost:3000

# Fecha prevista de baja de la versión v1 (cabecera X-API-Deprecation-Date)
API_DEPRECATION_DATE=2027-12-31

# false = no correr los jobs programados (útil al probar contra datos reales)
JOBS_ENABLED=true
